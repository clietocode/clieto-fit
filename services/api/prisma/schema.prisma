generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gym {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  timezone    String     @default("UTC")
  logoUrl     String?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  training    TrainingPlan[]
  diets       DietPlan[]
  attendance  Attendance[]
  fees        FeeStructure[]
  payments    Payment[]
  offers      Offer[]
  equipment   Equipment[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("USER")
  status       String     @default("ACTIVE")
  gymId        String?
  feeId        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  gym          Gym?       @relation(fields: [gymId], references: [id], onDelete: SetNull)
  fee          FeeStructure? @relation(fields: [feeId], references: [id], onDelete: SetNull)
  sessions     Session[]
  training     TrainingPlan[] @relation("TrainingMember")
  assignedTraining TrainingPlan[] @relation("TrainingCreator")
  diets        DietPlan[] @relation("DietMember")
  assignedDiets DietPlan[] @relation("DietCreator")
  attendance   Attendance[]
  payments     Payment[]
  audits       AuditLog[]

  @@index([gymId, role, status])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TrainingPlan {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  createdById String
  title       String
  details     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      User     @relation("TrainingMember", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TrainingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([gymId, memberId])
}

model DietPlan {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  createdById String
  title       String
  details     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      User     @relation("DietMember", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("DietCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([gymId, memberId])
}

model Attendance {
  id        String   @id @default(cuid())
  gymId     String
  userId    String
  localDate String
  checkedAt DateTime @default(now())
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId, localDate])
  @@index([gymId, localDate])
}

model FeeStructure {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  amountCents Int
  description String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  members     User[]
  payments    Payment[]
}

model Payment {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  feeId       String?
  billingMonth String
  amountCents Int
  expectedCents Int
  status      String
  dueAt       DateTime?
  recordedAt  DateTime @default(now())
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member      User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fee         FeeStructure? @relation(fields: [feeId], references: [id], onDelete: SetNull)

  @@unique([gymId, memberId, billingMonth])
  @@index([gymId, billingMonth, status])
}

model Offer {
  id          String   @id @default(cuid())
  gymId       String
  title       String
  description String
  enabled     Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model Equipment {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}
